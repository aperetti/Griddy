{
  "global_level": "INFO",
  "services": {
    "python_backend": {
      "default_level": "INFO",
      "overrides": {
        "api.access": "INFO",
        "src.analytics.routes": "INFO",
        "src.grid.topology_routes": "INFO",
        "src.discovery.routes": "INFO",
        "grid_modeling.cim_parser": "DEBUG"
      }
    },
    "node_backend": {
      "default_level": "INFO",
      "overrides": {
        "auth_middleware": "DEBUG"
      }
    }
  },
  "tracing": {
    "sampling_rate": 1.0,
    "enabled": true
  }
}
