# =============================================================================
# Grid Application — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# .env is gitignored. .env.example is the committed reference.
#
# Local dev:  backend loads .env automatically via python-dotenv
# Docker:     docker-compose reads .env for ${VAR} substitution;
#             containers get env vars injected directly by compose.
# =============================================================================

# --- Neo4j connection (local dev) -------------------------------------------
# Use localhost when running the backend outside Docker.
# Docker Compose overrides CIMG_URL inside containers to bolt://neo4j:7687.
CIMG_URL=bolt://localhost:7687
CIMG_USERNAME=neo4j
CIMG_PASSWORD=password123
CIMG_NEO4J_DATABASE=neo4j
CIMG_CIM_PROFILE=cimhub_2023
CIMG_IEC61970_301=8

# --- CIM model config --------------------------------------------------------
# Comma-separated model names matching what was ingested into Neo4j.
# Only used when no XML files are found on disk.
CIM_MODEL_NAMES=IEEE8500

# --- Neo4j auth (used by the neo4j Docker service) --------------------------
NEO4J_AUTH=neo4j/password123

# --- Port overrides (optional) -----------------------------------------------
BACKEND_PORT=8000
FRONTEND_PORT=8080
ADMIN_BACKEND_PORT=8090
ADMIN_FRONTEND_PORT=8091
WEBSITE_PORT=3002
